{
  "name": "crucix",
  "version": "2.0.0",
  "description": "Local intelligence engine - 25 OSINT sources, live dashboard, public demo at crucix.live, auto-refresh, optional LLM layer.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --trace-warnings server.mjs",
    "test": "node --test test/*.test.mjs",
    "sweep": "node apis/briefing.mjs",
    "inject": "node dashboard/inject.mjs",
    "brief": "node apis/briefing.mjs",
    "brief:save": "node apis/save-briefing.mjs",
    "diag": "node diag.mjs",
    "probe": "node scripts/browser-probe.mjs",
    "probe:map-popup": "node scripts/browser-probe.mjs --wait-for '.nuke-clickable[data-site]' scripts/probes/map-popup.probe.js",
    "probe:flat-map": "node scripts/browser-probe.mjs --wait-for '#flatMapSvg g.markers' scripts/probes/flat-map-layers.probe.js",
    "clean": "node scripts/clean.mjs",
    "fresh-start": "npm run clean && npm start"
  },
  "keywords": [
    "osint",
    "intelligence",
    "dashboard",
    "geopolitical"
  ],
  "author": "Crucix",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "express": "^5.1.0",
    "satellite.js": "^7.0.0"
  },
  "optionalDependencies": {
    "discord.js": "^14.25.1"
  },
  "overrides": {
    "undici": "^7.24.4"
  }
}
